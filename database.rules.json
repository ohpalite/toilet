{
  "rules": {
    ".read": false,
    ".write": false,
    "exam_map_state": {
      ".read": "auth != null",
      "$clusterId": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['isOccupied'])",
        "isOccupied": {
          ".validate": "newData.isBoolean()"
        },
        "occupiedBy": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 50)"
        },
        "occupiedSince": {
          ".validate": "!newData.exists() || (newData.isNumber() && newData.val() <= now)"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
